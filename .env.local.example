# ============================================================================
# AUTO ALIVE — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================================

# Supabase
# URL + anon key are read via src/lib/supabase/config.ts, which falls back to the
# known project values if these are unset at build time so the public site never
# goes down on a missing env var. Set them here for local dev anyway.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is env-only (never falls back, never shipped to the browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email)
RESEND_API_KEY=re_your_key_here

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dealer the storefront writes leads/stock against.
# Consumed via src/config/dealer.ts, which falls back to the Auto Alive dealer id
# if this is unset at build time so a missing env var never costs a lead.
NEXT_PUBLIC_DEALER_ID=00000000-0000-0000-0000-000000000001
